# Main chatbot provider — set ONE of these (Groq checked first).
# Without any key the app runs in mock mode (detectors still fully work).
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides
# PROVIDER=groq            # force: groq | openrouter | mock
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct

# Detector 2 (LLM-as-judge) backend: local (Qwen2.5-0.5B GGUF) | api
JUDGE_BACKEND=local
# GROQ_JUDGE_MODEL=llama-3.1-8b-instant
# OPENROUTER_JUDGE_MODEL=anthropic/claude-3.5-haiku

# Blocking policy default: or (either detector blocks) | and (both must fire)
POLICY=or
